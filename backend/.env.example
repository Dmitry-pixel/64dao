# ============================================================
# 64dao.ru — Backend Environment Variables
# Скопируйте как .env и заполните значения
# ============================================================

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DB_USER=dao64
DB_PASS=замените_на_надёжный_пароль
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dao64

# ── JWT ───────────────────────────────────────────────────────────────────────
# Генерация: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=замените_на_случайную_строку_минимум_32_символа

# ── SMTP (пример для Timeweb / reg.ru / хостинг-провайдера) ──────────────────
# Timeweb: smtp.timeweb.com, port 465, TLS
# reg.ru:  smtp.reg.ru, port 465, TLS
# Mail.ru: smtp.mail.ru, port 465, TLS
# Yandex:  smtp.yandex.ru, port 465, TLS
SMTP_HOST=smtp.timeweb.com
SMTP_PORT=465
SMTP_USER=noreply@64dao.ru
SMTP_PASS=замените_на_пароль_почты
SMTP_FROM=64DAO <noreply@64dao.ru>
SMTP_USE_TLS=true

# ── Application ───────────────────────────────────────────────────────────────
APP_URL=https://64dao.ru           # для CORS

# ── Admin setup ───────────────────────────────────────────────────────────────
# Используется один раз для создания первого администратора через /api/admin/setup
# После создания — оставьте пустым или удалите
ADMIN_SETUP_KEY=придумайте_секретный_ключ

# ── Storage ───────────────────────────────────────────────────────────────────
UPLOADS_DIR=/var/www/64dao/uploads/reports

# ── Debug ─────────────────────────────────────────────────────────────────────
# true = включает Swagger UI на /api/docs, SQL-логи
DEBUG=false

# ── Поддержка и OTP ──────────────────────────────────────────────────────────
SUPPORT_EMAIL=support@64dao.ru     # куда идут формы контакта и служебные письма
# OTP_EXPIRE_MINUTES=10
# OTP_MAX_ATTEMPTS=5               # неверных вводов на один код
# JWT_EXPIRE_DAYS=7

# ── Точка Банк ───────────────────────────────────────────────────────────────
# Токен можно задать и из админки (tochka_settings.json в томе uploads);
# значение из админки имеет приоритет.
TOCHKA_CUSTOMER_CODE=
TOCHKA_MERCHANT_ID=
TOCHKA_JWT_TOKEN=
TOCHKA_TAX_SYSTEM_CODE=usn_income
# TOCHKA_CA_BUNDLE задаётся в backend/Dockerfile, вручную не нужен.
# CA_EXPIRY_WARN_DAYS=60

# ── Флаги ────────────────────────────────────────────────────────────────────
# Значение из админки (credits_settings.json) имеет приоритет над ENFORCE_CREDITS.
ENFORCE_CREDITS=false
M3_ENABLED=false
FINANCE_BLOCK_REQUIRED=false
REMINDERS_ENABLED=true
# REPEAT_REMINDER_DAYS=90
# REGENERATE_PDF_ON_DOWNLOAD=true

# ── Задачи cron (необязательно, есть значения по умолчанию) ──────────────────
# RECONCILE_STALE_MINUTES=15
# RECONCILE_MAX_AGE_DAYS=7
# SMOKE_BASE_URL=https://64dao.ru
