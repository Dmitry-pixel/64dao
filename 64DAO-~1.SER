[Unit]
Description=64dao alert watcher (nginx 5xx + Tochka webhook)
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/64dao-alerts.env
# CONFIRM путь размещения скрипта на сервере:
ExecStart=/usr/bin/python3 /opt/64dao-alerts/alert_watcher.py
# только чтение лога и отправка почты — привилегии не нужны
User=root
