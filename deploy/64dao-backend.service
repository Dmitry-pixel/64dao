[Unit]
Description=64dao FastAPI Backend
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=exec
User=www-data
Group=www-data
WorkingDirectory=/var/www/64dao/backend

# Переменные окружения из файла
EnvironmentFile=/var/www/64dao/backend/.env

# Запуск через uvicorn
ExecStart=/var/www/64dao/venv/bin/uvicorn app.main:app \
    --host 127.0.0.1 \
    --port 8000 \
    --workers 2 \
    --loop asyncio \
    --access-log \
    --log-level info

# Автоматический перезапуск при падении
Restart=always
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=3

# Безопасность
NoNewPrivileges=true
PrivateTmp=true

# Логи
StandardOutput=journal
StandardError=journal
SyslogIdentifier=64dao-backend

[Install]
WantedBy=multi-user.target
